---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---

<Base title="Page not found · Mitchell Oriahi" description="That page does not exist." noindex>
    <div class="sheet">
        <main class="grid min-h-[80vh] place-items-center px-6 py-24 text-center">
            <div>
                <p class="hand text-2xl text-ink-soft">uh oh...</p>
                <p class="pixel my-4 text-[clamp(3.5rem,14vw,8rem)]">404</p>
                <span class="sticker st-yellow tilt-l mb-6">This page does not exist</span>

                <p class="mx-auto mt-5 max-w-[40ch] text-ink-soft">
                    The link is probably out of date, or the address has a typo
                    in it. Nothing is broken on your end.
                </p>

                <div class="mt-8 flex flex-wrap justify-center gap-3">
                    <a href="/" class="btn btn-solid">Back to the homepage</a>
                    <a href="/#work" class="btn">See the projects</a>
                    <a href={`mailto:${SITE.email}`} class="btn">Email me</a>
                </div>
            </div>
        </main>
    </div>
</Base>
