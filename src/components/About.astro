---
import { ABOUT, HOW_I_WORK, BEYOND, SITE } from '../data/site';
import Picture from './Picture.astro';
import type { ImageRef } from '../data/site';

const full = (img: ImageRef) =>
    `/img/${img.slug}-${img.widths[img.widths.length - 1]}.${img.ext ?? 'jpg'}`;
---

<section id="about" class="py-24 md:py-32">
    <div class="shell">

        <div class="grid gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">

            <!-- ---------- the story ---------- -->
            <div>
                <p class="eyebrow mb-5" data-reveal>About</p>

                <h2 class="display-lg mb-8" data-reveal-clip>
                    More than a <span class="accent-word">resume</span>.
                </h2>

                <div class="flex flex-col gap-5 text-ink-soft" data-reveal data-reveal-delay="0.1">
                    {ABOUT.paragraphs.map((para) => <p>{para}</p>)}
                </div>

                <div class="mt-9 flex flex-wrap gap-3" data-reveal data-reveal-delay="0.15">
                    <a href="#contact" class="btn btn-solid" data-magnetic="0.2">
                        Get in touch
                        <span class="btn-badge" aria-hidden="true">
                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 12 12 4M6 4h6v6" />
                            </svg>
                        </span>
                    </a>
                    <a href={SITE.linkedin} target="_blank" rel="noopener" class="btn btn-ghost">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10.5V17M8 7.5v.01M12 17v-3.6a2.4 2.4 0 0 1 4.8 0V17" />
                        </svg>
                        LinkedIn
                    </a>
                </div>
            </div>

            <!-- ---------- how I work, tucked beside the story ---------- -->
            <div>
                <p class="eyebrow mb-6" data-reveal>How I work</p>
                <ul class="flex flex-col gap-4" role="list">
                    {HOW_I_WORK.map((item, i) => (
                        <li
                            class="card flex gap-4 p-5 transition-[border-color,transform] duration-500 hover:-translate-y-0.5 hover:border-rule"
                            data-reveal
                            data-reveal-delay={String(i * 0.06)}
                        >
                            <span class="mt-0.5 font-mono text-[0.7rem] tracking-[0.14em] text-accent-deep">0{i + 1}</span>
                            <div>
                                <p class="mb-1 font-display text-xl leading-tight">{item.title}</p>
                                <p class="text-sm leading-relaxed text-ink-mute">{item.body}</p>
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
        </div>

        <!-- ---------- beyond the bench: snapshot piles ---------- -->
        <div class="mt-16 md:mt-20">
            <p class="eyebrow mb-2" data-reveal>Beyond the bench</p>
            <p class="mb-10 max-w-[52ch] text-ink-mute" data-reveal>
                The parts of the week that don't happen at a desk. Click a photo
                to see it properly.
            </p>

            <div class="grid gap-x-8 gap-y-14 sm:grid-cols-3">
                {BEYOND.map((item, i) => (
                    <article data-reveal data-reveal-delay={String(i * 0.07)}>
                        <!--
                            Two prints tossed on the desk: white borders, opposing
                            tilts, a slight overlap. Hovering straightens them,
                            like picking the pile up for a closer look.
                        -->
                        <div class="snap-pile group" data-parallax-scope>
                            {item.images.map((img, j) => (
                                <button
                                    type="button"
                                    class:list={['snap-print lb-trigger', j === 0 ? 'snap-a' : 'snap-b']}
                                    data-lb-group={`beyond-${i}`}
                                    data-lb-type="image"
                                    data-lb-full={full(img)}
                                    data-lb-caption={img.alt}
                                    aria-label={`View larger: ${img.alt}`}
                                >
                                    <Picture
                                        slug={img.slug}
                                        widths={img.widths}
                                        width={img.w}
                                        height={img.h}
                                        ext={img.ext}
                                        alt={img.alt}
                                        sizes="(min-width: 640px) 22vw, 60vw"
                                        class="aspect-[4/5] w-full rounded-[4px] object-cover"
                                    />
                                </button>
                            ))}
                        </div>

                        <h3 class="mt-6 font-display text-2xl leading-none">{item.title}</h3>
                        <p class="mt-2 text-sm leading-relaxed text-ink-mute">{item.body}</p>
                    </article>
                ))}
            </div>
        </div>
    </div>
</section>
