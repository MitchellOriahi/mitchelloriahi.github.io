---
import { ABOUT, HOW_I_WORK, BEYOND, SITE } from '../data/site';
import Picture from './Picture.astro';
import type { ImageRef } from '../data/site';

const full = (img: ImageRef) =>
    `/img/${img.slug}-${img.widths[img.widths.length - 1]}.${img.ext ?? 'jpg'}`;

const workColors = ['st-yellow', 'st-mint', 'st-sky'];
---

<section id="about" class="py-16 md:py-20">
    <div class="shell">

        <!-- ---------- more than a resume: handwriting story with polaroids ---------- -->
        <div class="mb-4 text-center">
            <span class="sec-tab" data-reveal>more than a resume</span>
        </div>

        <div class="relative mx-auto max-w-5xl">
            <!-- left polaroid: presenting the APRS board -->
            <figure class="polaroid tilt-l absolute -left-4 top-4 z-10 hidden w-44 lg:block" data-reveal>
                <span class="tape -top-3 left-1/2 -translate-x-1/2 -rotate-2" aria-hidden="true"></span>
                <img
                    src="/img/proj-aprs-team-400.jpg"
                    alt="The team presenting the APRS tracking system"
                    width="400" height="432"
                    class="aspect-[4/5] w-full object-cover"
                    loading="lazy" decoding="async"
                />
                <figcaption>demo day</figcaption>
            </figure>

            <!-- right polaroid: the bench -->
            <figure class="polaroid tilt-r absolute -right-4 top-10 z-10 hidden w-44 lg:block" data-reveal data-reveal-delay="0.08">
                <span class="tape tape-yellow -top-3 left-1/2 -translate-x-1/2 rotate-2" aria-hidden="true"></span>
                <img
                    src="/img/proj-combat-robot-400.jpg"
                    alt="The combat robot on the workbench"
                    width="400" height="533"
                    class="aspect-[4/5] w-full object-cover"
                    loading="lazy" decoding="async"
                />
                <figcaption>the bench</figcaption>
            </figure>

            <!-- the story, handwritten -->
            <div class="hand mx-auto max-w-[40rem] px-4 text-center text-[clamp(1.35rem,2.4vw,1.8rem)] leading-normal text-ink" data-reveal data-reveal-delay="0.1">
                {ABOUT.paragraphs.map((para) => (
                    <p class="mb-4">{para}</p>
                ))}
            </div>
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3" data-reveal>
            <a href="#contact" class="btn btn-solid" data-magnetic="0.18">
                Get in touch
            </a>
            <a href={SITE.linkedin} target="_blank" rel="noopener" class="btn">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.5v.01M12 17v-3.6a2.4 2.4 0 0 1 4.8 0V17"/></svg>
                LinkedIn
            </a>
        </div>

        <!-- ---------- how I work: three big stickers ---------- -->
        <div class="mt-16">
            <p class="hand-note mb-5 text-center" data-reveal>how I work</p>
            <ul class="grid gap-6 sm:grid-cols-3" role="list">
                {HOW_I_WORK.map((item, i) => (
                    <li
                        class="card relative p-5 pt-7"
                        data-reveal
                        data-reveal-delay={String(i * 0.06)}
                    >
                        <span class:list={['sticker absolute -top-3 left-4', workColors[i % 3]]}>
                            0{i + 1}
                        </span>
                        <p class="mb-1.5 text-lg font-extrabold tracking-tight">{item.title}</p>
                        <p class="text-sm leading-relaxed text-ink-soft">{item.body}</p>
                    </li>
                ))}
            </ul>
        </div>

        <!-- ---------- beyond the bench: snapshot piles ---------- -->
        <div class="mt-16">
            <p class="hand-note mb-1 text-center" data-reveal>beyond the bench</p>
            <p class="mb-12 text-center text-sm text-ink-mute" data-reveal>
                The parts of the week that don't happen at a desk. Click a photo
                to see it properly.
            </p>

            <div class="grid gap-x-10 gap-y-14 sm:grid-cols-3">
                {BEYOND.map((item, i) => (
                    <article data-reveal data-reveal-delay={String(i * 0.07)}>
                        <div class="snap-pile group" data-parallax-scope>
                            {item.images.map((img, j) => (
                                <button
                                    type="button"
                                    class:list={['snap-print lb-trigger', j === 0 ? 'snap-a' : 'snap-b']}
                                    data-lb-group={`beyond-${i}`}
                                    data-lb-type="image"
                                    data-lb-full={full(img)}
                                    data-lb-caption={img.alt}
                                    aria-label={`View larger: ${img.alt}`}
                                >
                                    <Picture
                                        slug={img.slug}
                                        widths={img.widths}
                                        width={img.w}
                                        height={img.h}
                                        ext={img.ext}
                                        alt={img.alt}
                                        sizes="(min-width: 640px) 22vw, 60vw"
                                        class="aspect-[4/5] w-full rounded-[2px] object-cover"
                                    />
                                </button>
                            ))}
                        </div>

                        <h3 class="hand mt-6 text-center text-2xl text-ink">{item.title}</h3>
                        <p class="mx-auto mt-1.5 max-w-[34ch] text-center text-sm leading-relaxed text-ink-mute">{item.body}</p>
                    </article>
                ))}
            </div>
        </div>
    </div>
</section>
