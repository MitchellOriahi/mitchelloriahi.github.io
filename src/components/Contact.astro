---
import { SITE, NAV } from '../data/site';

const links = [
    {
        label: 'Email',
        value: SITE.email,
        href: `mailto:${SITE.email}`,
        icon: 'mail',
    },
    {
        label: 'LinkedIn',
        value: 'in/mitchell-oriahi-ce',
        href: SITE.linkedin,
        icon: 'linkedin',
    },
    {
        label: 'GitHub',
        value: 'MitchellOriahi',
        href: SITE.github,
        icon: 'github',
    },
    {
        label: 'Resume',
        value: 'One page PDF',
        href: SITE.resume,
        icon: 'file',
    },
];

const paths: Record<string, string> = {
    mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7L22 7"/>',
    linkedin: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.5v.01M12 17v-3.6a2.4 2.4 0 0 1 4.8 0V17"/>',
    github: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
    file: '<path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7Z"/><path d="M14 2v5h5M9 13h6M9 17h4"/>',
};
---

<section id="contact" class="band-ink relative overflow-hidden pt-24 md:pt-36">
    <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(55%_60%_at_50%_100%,rgba(217,131,36,0.2),transparent_65%)]"
    ></div>

    <div class="shell relative">

        <div class="grid gap-12 pb-20 md:pb-28 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">

            <div>
                <p class="eyebrow mb-6" data-reveal>Contact</p>

                <h2 class="display-lg mb-7 text-bone" data-reveal-clip>
                    Say <span class="text-marigold italic">hello</span>.
                </h2>

                <p class="lede mb-10 text-bone/65" data-reveal data-reveal-delay="0.1">
                    I'm looking for full time engineering roles starting after I
                    graduate in {SITE.graduation}, and I'm keeping my options open.
                    If you think I'd be a good fit for your team, I'd genuinely
                    love to hear from you.
                </p>

                <div class="flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="0.15">
                    <a
                        href={`mailto:${SITE.email}`}
                        class="btn btn-amber"
                        data-magnetic="0.22"
                    >
                        Email me
                        <span class="btn-badge" aria-hidden="true">
                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 12 12 4M6 4h6v6" />
                            </svg>
                        </span>
                    </a>
                    <a
                        href={SITE.resume}
                        target="_blank"
                        rel="noopener"
                        class="btn border border-bone/25 text-bone hover:border-bone hover:bg-bone hover:text-ink"
                    >
                        Download resume
                    </a>
                </div>

                <p class="mt-8 font-mono text-[0.72rem] uppercase tracking-[0.14em] text-bone/40" data-reveal data-reveal-delay="0.2">
                    Based in {SITE.baseLocation} · Studying in {SITE.schoolLocation}
                </p>
            </div>

            <!-- ---------- link list ---------- -->
            <ul class="flex flex-col" role="list" data-reveal data-reveal-delay="0.1">
                {links.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            target={link.href.startsWith('http') || link.href.endsWith('.pdf') ? '_blank' : undefined}
                            rel={link.href.startsWith('http') || link.href.endsWith('.pdf') ? 'noopener' : undefined}
                            class="group flex items-center gap-5 border-t border-bone/15 py-6 transition-colors duration-400 last:border-b hover:bg-bone/[0.04]"
                        >
                            <span class="grid h-11 w-11 flex-none place-items-center rounded-full border border-bone/20 text-bone/70 transition-colors duration-400 group-hover:border-marigold group-hover:bg-marigold group-hover:text-ink">
                                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[link.icon]} />
                            </span>
                            <span class="min-w-0">
                                <span class="block font-mono text-[0.68rem] uppercase tracking-[0.16em] text-bone/40">
                                    {link.label}
                                </span>
                                <span class="block truncate text-[0.98rem] text-bone">{link.value}</span>
                            </span>
                            <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="ml-auto flex-none text-bone/30 transition-all duration-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-marigold" aria-hidden="true">
                                <path d="M4 12 12 4M6 4h6v6" />
                            </svg>
                        </a>
                    </li>
                ))}
            </ul>
        </div>

        <!-- ---------- oversized signature ---------- -->
        <div class="relative border-t border-bone/12 py-10" aria-hidden="true">
            <p class="display-xl select-none text-center leading-[0.8] text-bone/[0.07]">
                Mitchell Oriahi
            </p>
        </div>

        <!-- ---------- footer bar ---------- -->
        <footer class="flex flex-col gap-5 border-t border-bone/12 py-8 md:flex-row md:items-center md:justify-between">
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-bone/45">
                © <span id="year">2026</span> {SITE.name}
            </p>

            <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
                {NAV.map((item) => (
                    <a href={`#${item.id}`} class="link-line text-sm text-bone/55 hover:text-bone">
                        {item.label}
                    </a>
                ))}
                <a href="#contact" class="link-line text-sm text-bone/55 hover:text-bone">Contact</a>
            </nav>

            <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-bone/45">
                Built with Astro
            </p>
        </footer>
    </div>
</section>
