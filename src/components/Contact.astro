---
import { SITE, NAV } from '../data/site';

const links = [
    { label: 'Email', value: SITE.email, href: `mailto:${SITE.email}`, color: 'st-yellow', icon: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7L22 7"/>' },
    { label: 'LinkedIn', value: 'in/mitchell-oriahi-ce', href: SITE.linkedin, color: 'st-sky', icon: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.5v.01M12 17v-3.6a2.4 2.4 0 0 1 4.8 0V17"/>' },
    { label: 'GitHub', value: 'MitchellOriahi', href: SITE.github, color: 'st-mint', icon: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>' },
    { label: 'Resume', value: 'One page PDF', href: SITE.resume, color: 'st-pink', icon: '<path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7Z"/><path d="M14 2v5h5M9 13h6M9 17h4"/>' },
];
---

<section id="contact" class="border-t-2 border-ink pt-14 pb-8 md:pt-16" style="background: var(--color-st-butter)">
    <div class="shell">

        <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">

            <div>
                <p class="hand-note mb-2" data-reveal>let's talk</p>
                <h2 class="mb-5 text-[clamp(2rem,4.5vw,3.2rem)] font-extrabold tracking-tight" data-reveal>
                    Say <span class="hl">hello</span>.
                </h2>

                <p class="mb-8 max-w-[48ch] text-[1.02rem] leading-relaxed text-ink-soft" data-reveal data-reveal-delay="0.08">
                    I'm looking for full time engineering roles starting after I
                    graduate in {SITE.graduation}, and I'm keeping my options open.
                    If you think I'd be a good fit for your team, I'd genuinely
                    love to hear from you.
                </p>

                <div class="flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="0.12">
                    <a href={`mailto:${SITE.email}`} class="btn btn-solid" data-magnetic="0.18">
                        <span class="btn-badge" aria-hidden="true">
                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12 12 4M6 4h6v6"/></svg>
                        </span>
                        Email me
                    </a>
                    <a href={SITE.resume} target="_blank" rel="noopener" class="btn">Download resume</a>
                </div>

                <p class="label-mono mt-7 text-ink-mute" data-reveal data-reveal-delay="0.15">
                    Based in {SITE.baseLocation} · Studying in {SITE.schoolLocation}
                </p>
            </div>

            <!-- link cards -->
            <ul class="flex flex-col gap-4" role="list" data-reveal data-reveal-delay="0.1">
                {links.map((link, i) => (
                    <li>
                        <a
                            href={link.href}
                            target={link.href.startsWith('http') || link.href.endsWith('.pdf') ? '_blank' : undefined}
                            rel={link.href.startsWith('http') || link.href.endsWith('.pdf') ? 'noopener' : undefined}
                            class="card group flex items-center gap-4 p-4 transition-transform duration-200 hover:-translate-x-1 hover:-translate-y-1"
                        >
                            <span class:list={['sticker !p-2', link.color]} aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={link.icon} />
                            </span>
                            <span class="min-w-0">
                                <span class="label-mono block text-ink-mute">{link.label}</span>
                                <span class="block truncate text-[0.95rem] font-bold">{link.value}</span>
                            </span>
                            <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto flex-none text-ink transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">
                                <path d="M4 12 12 4M6 4h6v6" />
                            </svg>
                        </a>
                    </li>
                ))}
            </ul>
        </div>

        <!-- footer -->
        <footer class="mt-12 border-t-2 border-ink/15 pt-6 pb-2">
            <div class="flex flex-col items-center gap-4 md:flex-row md:justify-between">
                <p class="hand text-3xl text-ink" aria-hidden="true">Mitchell Oriahi</p>

                <nav aria-label="Footer" class="flex flex-wrap justify-center gap-x-5 gap-y-2">
                    {NAV.map((item) => (
                        <a href={`#${item.id}`} class="label-mono text-ink-mute underline-offset-4 hover:underline">
                            {item.label}
                        </a>
                    ))}
                    <a href="#contact" class="label-mono text-ink-mute underline-offset-4 hover:underline">Contact</a>
                </nav>

                <p class="label-mono text-ink-mute">
                    © <span id="year">2026</span> · Built with Astro
                </p>
            </div>
        </footer>
    </div>
</section>
