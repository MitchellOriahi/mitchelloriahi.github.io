---
import { FEATURED, PROJECTS_MORE } from '../data/site';
import Picture from './Picture.astro';
import { highlight } from '../lib/highlight';
import type { ImageRef } from '../data/site';

const counts = {
    all: FEATURED.length + PROJECTS_MORE.length,
    hardware: [...FEATURED, ...PROJECTS_MORE].filter((p) => p.kind === 'hardware').length,
    software: [...FEATURED, ...PROJECTS_MORE].filter((p) => p.kind === 'software').length,
};

const full = (img: ImageRef) =>
    `/img/${img.slug}-${img.widths[img.widths.length - 1]}.${img.ext ?? 'jpg'}`;

const expandIcon = `<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7"/></svg>`;

/* Alternating slab grounds like the reference's black / blue / yellow cards. */
const grounds = [
    { slab: 'slab-dark',   body: 'text-white/75', meta: 'text-white/55', title: 'text-white', tab: 'st-blue' },
    { slab: 'slab-blue',   body: 'text-white/80', meta: 'text-white/60', title: 'text-white', tab: 'st-yellow' },
    { slab: 'slab-yellow', body: 'text-ink/75',   meta: 'text-ink/60',   title: 'text-ink',   tab: 'st-pink' },
];
---

<section id="work" class="py-14 md:py-16">
    <div class="shell">

        <header class="mb-8 md:mb-10">
            <p class="hand-note mb-2" data-reveal>stuff I actually built</p>
            <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
                <h2 class="text-[clamp(1.9rem,4vw,2.9rem)] font-extrabold tracking-tight">
                    What I've <span class="hl">built</span>.
                </h2>
                <p class="max-w-[36ch] pb-1 text-sm text-ink-mute">
                    From competition robots to cloud tools. Filter by side, and
                    click any photo to see it full size.
                </p>
            </div>
        </header>

        <!-- filters -->
        <div class="mb-12 flex flex-wrap gap-2.5" role="group" aria-label="Filter projects" data-reveal>
            <button type="button" class="filter-chip" data-filter="all" aria-pressed="true">
                All <span class="count">{counts.all}</span>
            </button>
            <button type="button" class="filter-chip" data-filter="hardware" aria-pressed="false">
                Hardware <span class="count">{counts.hardware}</span>
            </button>
            <button type="button" class="filter-chip" data-filter="software" aria-pressed="false">
                Software <span class="count">{counts.software}</span>
            </button>
            <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>
        </div>

        <!-- featured slabs -->
        <div class="flex flex-col gap-12">
            {FEATURED.map((project, i) => {
                const g = grounds[i % grounds.length];
                return (
                    <div class="relative" data-kind={project.kind} data-project data-reveal data-reveal-delay={String(i * 0.05)}>
                        <span class:list={['sticker slab-tab', g.tab]}>
                            ✦ Project 0{i + 1}
                        </span>

                        <article class:list={['slab p-6 pt-9 md:p-8 md:pt-10', g.slab]}>
                            <div class="grid gap-7 lg:grid-cols-[1.12fr_0.88fr] lg:gap-10">

                                <!-- text -->
                                <div class="flex flex-col">
                                    <p class:list={['label-mono mb-3', g.meta]}>
                                        {project.period} · {project.org} · {project.role}
                                    </p>

                                    <h3 class:list={['mb-3 text-3xl font-extrabold tracking-tight md:text-4xl', g.title]}>
                                        {project.title}
                                    </h3>

                                    <p class:list={['mb-4 max-w-[52ch] text-[0.98rem] leading-relaxed', g.body]}>
                                        {project.summary}
                                    </p>

                                    <div class="mb-5 flex flex-wrap gap-2.5">
                                        {project.metrics.map((metric) => (
                                            <span class:list={['sticker', i === 2 ? 'st-white' : 'st-yellow']}>
                                                {metric.value} · {metric.label}
                                            </span>
                                        ))}
                                    </div>

                                    <ul class="mb-6 flex flex-col gap-2.5" role="list">
                                        {project.detail.map((line) => (
                                            <li class:list={['relative pl-6 text-[0.92rem] leading-relaxed', g.body]}>
                                                <span aria-hidden="true" class="absolute left-0 top-[0.5em] h-2 w-2 rounded-sm border border-ink" style="background: var(--color-st-orange)"></span>
                                                <Fragment set:html={highlight(line)} />
                                            </li>
                                        ))}
                                    </ul>

                                    <div class="mt-auto flex flex-wrap gap-2">
                                        {project.stack.map((tech) => (
                                            <span class="sticker st-white">{tech}</span>
                                        ))}
                                    </div>
                                </div>

                                <!-- media, taped down -->
                                <div class="flex flex-col justify-center gap-4">
                                    {project.video ? (
                                        <>
                                            <div class="relative mx-auto w-fit">
                                                <span class="tape tape-yellow -top-3 left-1/2 -translate-x-1/2 -rotate-3" aria-hidden="true"></span>
                                                <video
                                                    src={project.video.src}
                                                    poster={project.video.poster}
                                                    controls
                                                    playsinline
                                                    preload="none"
                                                    width={project.video.w}
                                                    height={project.video.h}
                                                    class="h-auto max-h-[380px] w-auto rounded-md border-[3px] border-white bg-black shadow-[0_10px_24px_-10px_rgba(0,0,0,0.6)]"
                                                    aria-label={`Demo video: ${project.title}`}
                                                ></video>
                                            </div>
                                            {project.gallery.length > 0 && (
                                                <div class="grid grid-cols-2 gap-4">
                                                    {project.gallery.map((img, j) => (
                                                        <button
                                                            type="button"
                                                            class:list={['lb-trigger snap-print !w-full', j % 2 ? 'tilt-r2' : 'tilt-l2']}
                                                            data-lb-group={project.slug}
                                                            data-lb-type="image"
                                                            data-lb-full={full(img)}
                                                            data-lb-caption={img.alt}
                                                            aria-label={`View larger: ${img.alt}`}
                                                        >
                                                            <Picture
                                                                slug={img.slug}
                                                                widths={img.widths}
                                                                width={img.w}
                                                                height={img.h}
                                                                ext={img.ext}
                                                                alt={img.alt}
                                                                sizes="(min-width: 1024px) 18vw, 45vw"
                                                                class="aspect-[4/3] w-full rounded-[2px] object-cover"
                                                            />
                                                            <span class="lb-hint" set:html={expandIcon} />
                                                        </button>
                                                    ))}
                                                </div>
                                            )}
                                        </>
                                    ) : project.gallery.length > 0 ? (
                                        <>
                                            <div class="relative">
                                                <span class="tape -top-3 left-6 -rotate-6" aria-hidden="true"></span>
                                                <span class="tape tape-pink -top-3 right-6 rotate-3" aria-hidden="true"></span>
                                                <button
                                                    type="button"
                                                    class="lb-trigger snap-print !w-full !p-1.5 !pb-1.5"
                                                    data-lb-group={project.slug}
                                                    data-lb-type="image"
                                                    data-lb-full={full(project.gallery[0])}
                                                    data-lb-caption={project.gallery[0].alt}
                                                    aria-label={`View larger: ${project.gallery[0].alt}`}
                                                >
                                                    <Picture
                                                        slug={project.gallery[0].slug}
                                                        widths={project.gallery[0].widths}
                                                        width={project.gallery[0].w}
                                                        height={project.gallery[0].h}
                                                        ext={project.gallery[0].ext}
                                                        alt={project.gallery[0].alt}
                                                        sizes="(min-width: 1024px) 36vw, 90vw"
                                                        class="max-h-[380px] w-full rounded-[2px] object-cover"
                                                    />
                                                    <span class="lb-hint" set:html={expandIcon} />
                                                </button>
                                            </div>
                                            {project.gallery.length > 1 && (
                                                <div class="grid grid-cols-3 gap-3">
                                                    {project.gallery.slice(1).map((img) => (
                                                        <button
                                                            type="button"
                                                            class="lb-trigger snap-print !w-full !p-1 !pb-1 tilt-r2"
                                                            data-lb-group={project.slug}
                                                            data-lb-type="image"
                                                            data-lb-full={full(img)}
                                                            data-lb-caption={img.alt}
                                                            aria-label={`View larger: ${img.alt}`}
                                                        >
                                                            <Picture
                                                                slug={img.slug}
                                                                widths={img.widths}
                                                                width={img.w}
                                                                height={img.h}
                                                                ext={img.ext}
                                                                alt={img.alt}
                                                                sizes="12vw"
                                                                class="aspect-[4/3] w-full rounded-[2px] object-cover"
                                                            />
                                                            <span class="lb-hint" set:html={expandIcon} />
                                                        </button>
                                                    ))}
                                                </div>
                                            )}
                                        </>
                                    ) : (
                                        <div class="grid aspect-[4/3] max-h-[380px] w-full place-items-center rounded-md border-2 border-dashed border-white/40 p-6 text-center">
                                            <p class="label-mono text-white/60">Photo coming</p>
                                        </div>
                                    )}
                                </div>
                            </div>
                        </article>
                    </div>
                );
            })}
        </div>

        <!-- the rest: white cards, three across -->
        <p class="hand-note mt-14 mb-6" data-reveal>and a few more...</p>

        <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
            {PROJECTS_MORE.map((project, i) => (
                <article
                    class="card group flex flex-col overflow-visible"
                    data-kind={project.kind}
                    data-project
                    data-reveal
                    data-reveal-delay={String((i % 3) * 0.06)}
                >
                    {project.gallery.length > 0 ? (
                        <div class="relative p-3 pb-0">
                            <span class="tape -top-2.5 left-1/2 -translate-x-1/2 -rotate-2" aria-hidden="true"></span>
                            <button
                                type="button"
                                class="lb-trigger overflow-hidden rounded-md border-2 border-ink"
                                data-lb-group={project.slug}
                                data-lb-type="image"
                                data-lb-full={full(project.gallery[0])}
                                data-lb-caption={project.gallery[0].alt}
                                aria-label={`View larger: ${project.gallery[0].alt}`}
                            >
                                <Picture
                                    slug={project.gallery[0].slug}
                                    widths={project.gallery[0].widths}
                                    width={project.gallery[0].w}
                                    height={project.gallery[0].h}
                                    ext={project.gallery[0].ext}
                                    alt={project.gallery[0].alt}
                                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
                                    class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03]"
                                />
                                <span class="lb-hint" set:html={expandIcon} />
                                {(project.gallery.length + (project.video ? 1 : 0)) > 1 && (
                                    <span class="lb-count">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="3" y="7" width="14" height="14" rx="2" />
                                            <path d="M7 3h12a2 2 0 0 1 2 2v12" />
                                        </svg>
                                        {project.gallery.length > 1 ? `${project.gallery.length} photos` : 'photo'}{project.video ? ' + video' : ''}
                                    </span>
                                )}
                            </button>
                        </div>
                    ) : null}

                    <!-- hidden extra gallery items so the lightbox can page them -->
                    {project.gallery.slice(1).map((img) => (
                        <button
                            type="button"
                            class="sr-only"
                            data-lb-group={project.slug}
                            data-lb-type="image"
                            data-lb-full={full(img)}
                            data-lb-caption={img.alt}
                            aria-label={`View: ${img.alt}`}
                        >{img.alt}</button>
                    ))}
                    {project.video && (
                        <button
                            type="button"
                            class="sr-only"
                            data-lb-group={project.slug}
                            data-lb-type="video"
                            data-lb-full={project.video.src}
                            data-lb-poster={project.video.poster}
                            data-lb-caption={`${project.title} demo video`}
                            aria-label={`Watch demo video: ${project.title}`}
                        >Demo video</button>
                    )}

                    <div class="flex flex-1 flex-col gap-2 p-5">
                        <p class="label-mono text-ink-mute">{project.context} · {project.when}</p>
                        <h4 class="text-xl font-extrabold leading-tight tracking-tight">{project.title}</h4>
                        <p class="text-sm leading-relaxed text-ink-soft">{project.desc}</p>
                        <div class="mt-auto flex flex-wrap items-center gap-2 pt-3">
                            {project.stack.map((tech) => <span class="chip">{tech}</span>)}
                            {project.video && (
                                <button
                                    type="button"
                                    class="chip cursor-pointer font-semibold"
                                    style="background: var(--color-st-yellow)"
                                    data-lb-open-group={project.slug}
                                >
                                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m10 8.5 6 3.5-6 3.5Z"/></svg>
                                    Watch demo
                                </button>
                            )}
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>
