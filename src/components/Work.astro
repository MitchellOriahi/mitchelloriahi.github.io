---
import { FEATURED, PROJECTS_MORE } from '../data/site';
import Picture from './Picture.astro';
import { highlight } from '../lib/highlight';
import type { ImageRef } from '../data/site';

const accentVar: Record<string, string> = {
    marigold: 'var(--color-marigold)',
    clay: 'var(--color-clay)',
    moss: 'var(--color-moss)',
};

const counts = {
    all: FEATURED.length + PROJECTS_MORE.length,
    hardware: [...FEATURED, ...PROJECTS_MORE].filter((p) => p.kind === 'hardware').length,
    software: [...FEATURED, ...PROJECTS_MORE].filter((p) => p.kind === 'software').length,
};

/** Largest derivative of an image, for the lightbox. */
const full = (img: ImageRef) =>
    `/img/${img.slug}-${img.widths[img.widths.length - 1]}.${img.ext ?? 'jpg'}`;

const expandIcon = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7"/></svg>`;
---

<section id="work" class="pt-10 pb-24 md:pt-12 md:pb-32">
    <div class="shell">

        <header class="mb-10 md:mb-14">
            <p class="eyebrow mb-5" data-reveal>Projects</p>
            <div class="grid gap-6 md:grid-cols-[1.2fr_0.8fr] md:items-end">
                <h2 class="display-lg" data-reveal-clip>
                    What I've <span class="accent-word">built</span>.
                </h2>
                <p class="text-ink-mute md:pb-2" data-reveal data-reveal-delay="0.1">
                    From competition robots to cloud tools. Filter by side, and
                    click any photo to see it full size.
                </p>
            </div>
        </header>

        <!-- ---------- filters ---------- -->
        <div class="mb-8 flex flex-wrap gap-2.5 md:mb-10" role="group" aria-label="Filter projects" data-reveal>
            <button type="button" class="filter-chip" data-filter="all" aria-pressed="true">
                All <span class="count">{counts.all}</span>
            </button>
            <button type="button" class="filter-chip" data-filter="hardware" aria-pressed="false">
                Hardware <span class="count">{counts.hardware}</span>
            </button>
            <button type="button" class="filter-chip" data-filter="software" aria-pressed="false">
                Software <span class="count">{counts.software}</span>
            </button>
            <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>
        </div>

        <!--
            One continuous family of cards. The three flagship builds span the
            full row with a horizontal layout; the rest sit three across. The
            size difference reads as rhythm, not as ranking.
        -->
        <div class="flex flex-col gap-5 md:gap-6">
            {FEATURED.map((project, i) => (
                <article
                    class="card group relative overflow-hidden p-6 transition-[border-color] duration-500 hover:border-rule md:p-7"
                    data-kind={project.kind}
                    data-project
                    data-reveal
                    data-reveal-delay={String(i * 0.05)}
                    style={`--accent:${accentVar[project.accent]}`}
                >
                    <span
                        aria-hidden="true"
                        class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-x-100"
                        style="background:var(--accent)"
                    ></span>

                    <div class="grid gap-7 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">

                        <!-- text -->
                        <div class="flex flex-col">
                            <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
                                <span class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-mute">{project.org}</span>
                                <span class="h-px w-6 bg-rule"></span>
                                <span class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-faint">{project.role} · {project.period}</span>
                            </div>

                            <h3 class="mb-3 font-display text-3xl leading-tight md:text-4xl">{project.title}</h3>

                            <p class="mb-4 max-w-[50ch] text-ink-soft">{project.summary}</p>

                            <div class="mb-5 flex flex-wrap gap-2">
                                {project.metrics.map((metric) => (
                                    <span class="rounded-lg border border-marigold/35 bg-marigold-wash px-3 py-1.5 font-mono text-[0.7rem] tracking-[0.05em] text-marigold-deep">
                                        {metric.value} · {metric.label}
                                    </span>
                                ))}
                            </div>

                            <ul class="mb-6 flex flex-col gap-2.5" role="list">
                                {project.detail.map((line) => (
                                    <li class="relative pl-5 text-[0.92rem] leading-relaxed text-ink-mute">
                                        <span aria-hidden="true" class="absolute left-0 top-[0.62em] h-1.5 w-1.5 rounded-full" style="background:var(--accent)"></span>
                                        <Fragment set:html={highlight(line)} />
                                    </li>
                                ))}
                            </ul>

                            <div class="mt-auto flex flex-wrap gap-2">
                                {project.stack.map((tech) => <span class="chip">{tech}</span>)}
                            </div>
                        </div>

                        <!-- media -->
                        <div class="flex flex-col justify-center gap-3">
                            {project.video ? (
                                <>
                                    <!-- Shown at its natural aspect, never cropped. -->
                                    <div class="flex justify-center overflow-hidden rounded-2xl bg-ink/[0.04] p-3">
                                        <video
                                            src={project.video.src}
                                            poster={project.video.poster}
                                            controls
                                            playsinline
                                            preload="none"
                                            width={project.video.w}
                                            height={project.video.h}
                                            class="h-auto max-h-[400px] w-auto rounded-xl"
                                            aria-label={`Demo video: ${project.title}`}
                                        ></video>
                                    </div>
                                    {project.gallery.length > 0 && (
                                        <div class="grid grid-cols-2 gap-3">
                                            {project.gallery.map((img) => (
                                                <button
                                                    type="button"
                                                    class="lb-trigger rounded-xl"
                                                    data-lb-group={project.slug}
                                                    data-lb-type="image"
                                                    data-lb-full={full(img)}
                                                    data-lb-caption={img.alt}
                                                    aria-label={`View larger: ${img.alt}`}
                                                >
                                                    <Picture
                                                        slug={img.slug}
                                                        widths={img.widths}
                                                        width={img.w}
                                                        height={img.h}
                                                        ext={img.ext}
                                                        alt={img.alt}
                                                        sizes="(min-width: 1024px) 18vw, 45vw"
                                                        class="aspect-[4/3] w-full rounded-xl object-cover"
                                                    />
                                                    <span class="lb-hint" set:html={expandIcon} />
                                                </button>
                                            ))}
                                        </div>
                                    )}
                                </>
                            ) : project.gallery.length > 0 ? (
                                <>
                                    <button
                                        type="button"
                                        class="lb-trigger rounded-2xl"
                                        data-lb-group={project.slug}
                                        data-lb-type="image"
                                        data-lb-full={full(project.gallery[0])}
                                        data-lb-caption={project.gallery[0].alt}
                                        aria-label={`View larger: ${project.gallery[0].alt}`}
                                    >
                                        <Picture
                                            slug={project.gallery[0].slug}
                                            widths={project.gallery[0].widths}
                                            width={project.gallery[0].w}
                                            height={project.gallery[0].h}
                                            ext={project.gallery[0].ext}
                                            alt={project.gallery[0].alt}
                                            sizes="(min-width: 1024px) 36vw, 90vw"
                                            class="max-h-[420px] w-full rounded-2xl object-cover"
                                        />
                                        <span class="lb-hint" set:html={expandIcon} />
                                    </button>
                                    {project.gallery.length > 1 && (
                                        <div class="grid grid-cols-3 gap-3">
                                            {project.gallery.slice(1).map((img) => (
                                                <button
                                                    type="button"
                                                    class="lb-trigger rounded-xl"
                                                    data-lb-group={project.slug}
                                                    data-lb-type="image"
                                                    data-lb-full={full(img)}
                                                    data-lb-caption={img.alt}
                                                    aria-label={`View larger: ${img.alt}`}
                                                >
                                                    <Picture
                                                        slug={img.slug}
                                                        widths={img.widths}
                                                        width={img.w}
                                                        height={img.h}
                                                        ext={img.ext}
                                                        alt={img.alt}
                                                        sizes="12vw"
                                                        class="aspect-[4/3] w-full rounded-xl object-cover"
                                                    />
                                                    <span class="lb-hint" set:html={expandIcon} />
                                                </button>
                                            ))}
                                        </div>
                                    )}
                                </>
                            ) : (
                                <div class="grid aspect-[4/3] max-h-[420px] w-full place-items-center rounded-2xl border border-dashed border-ink/20 bg-bone-deep p-6 text-center">
                                    <div>
                                        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-3 text-ink-faint" aria-hidden="true">
                                            <rect x="3" y="4" width="18" height="16" rx="2" />
                                            <path d="m3 15 5-5 4 4 3-3 6 6" /><circle cx="9" cy="9" r="1.4" />
                                        </svg>
                                        <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-ink-mute">Photo coming</p>
                                    </div>
                                </div>
                            )}
                        </div>

                    </div>
                </article>
            ))}

            <!-- ---------- the rest, same family, three across ---------- -->
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {PROJECTS_MORE.map((project, i) => (
                    <article
                        class="card group flex flex-col overflow-hidden transition-[border-color,transform] duration-500 hover:-translate-y-1 hover:border-rule"
                        data-kind={project.kind}
                        data-project
                        data-reveal
                        data-reveal-delay={String((i % 3) * 0.06)}
                    >
                        {project.gallery.length > 0 ? (
                            <button
                                type="button"
                                class="lb-trigger"
                                data-lb-group={project.slug}
                                data-lb-type="image"
                                data-lb-full={full(project.gallery[0])}
                                data-lb-caption={project.gallery[0].alt}
                                aria-label={`View larger: ${project.gallery[0].alt}`}
                            >
                                <Picture
                                    slug={project.gallery[0].slug}
                                    widths={project.gallery[0].widths}
                                    width={project.gallery[0].w}
                                    height={project.gallery[0].h}
                                    ext={project.gallery[0].ext}
                                    alt={project.gallery[0].alt}
                                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
                                    class="aspect-[4/3] w-full object-cover transition-transform duration-[1.2s] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]"
                                />
                                <span class="lb-hint" set:html={expandIcon} />
                            </button>
                        ) : (
                            <div class="relative grid aspect-[4/3] w-full place-items-center overflow-hidden bg-marigold-wash" aria-hidden="true">
                                <span class="blob absolute -right-8 -top-10 h-40 w-40 opacity-60"></span>
                                <p class="relative font-display text-3xl italic text-marigold-deep">You're here.</p>
                            </div>
                        )}

                        <!-- extra gallery items registered invisibly so the
                             lightbox can page through them all -->
                        {project.gallery.slice(1).map((img) => (
                            <button
                                type="button"
                                class="sr-only"
                                data-lb-group={project.slug}
                                data-lb-type="image"
                                data-lb-full={full(img)}
                                data-lb-caption={img.alt}
                                aria-label={`View: ${img.alt}`}
                            >{img.alt}</button>
                        ))}
                        {project.video && (
                            <button
                                type="button"
                                class="sr-only"
                                data-lb-group={project.slug}
                                data-lb-type="video"
                                data-lb-full={project.video.src}
                                data-lb-poster={project.video.poster}
                                data-lb-caption={`${project.title} demo video`}
                                aria-label={`Watch demo video: ${project.title}`}
                            >Demo video</button>
                        )}

                        <div class="flex flex-1 flex-col gap-2.5 p-5 md:p-6">
                            <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-ink-faint">
                                <span>{project.context}</span>
                                <span class="text-ink-faint/60">·</span>
                                <span>{project.when}</span>
                            </p>
                            <h4 class="font-display text-2xl leading-tight">{project.title}</h4>
                            <p class="text-sm leading-relaxed text-ink-mute">{project.desc}</p>
                            <div class="mt-auto flex flex-wrap items-center gap-2 pt-3">
                                {project.stack.map((tech) => <span class="chip">{tech}</span>)}
                                {project.video && (
                                    <button
                                        type="button"
                                        class="chip cursor-pointer border-marigold/50 bg-marigold-wash font-semibold text-marigold-deep transition-colors hover:bg-marigold hover:text-ink"
                                        data-lb-open-group={project.slug}
                                    >
                                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m10 8.5 6 3.5-6 3.5Z"/></svg>
                                        Watch demo
                                    </button>
                                )}
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </div>
</section>
