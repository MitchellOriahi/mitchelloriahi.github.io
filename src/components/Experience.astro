---
import { ROLES } from '../data/site';
import Picture from './Picture.astro';
import { highlight } from '../lib/highlight';
---

<section id="experience" class="band-ink relative overflow-hidden py-24 md:py-32">
    <!-- warm glow so the dark band is not a flat rectangle -->
    <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-0 bg-[radial-gradient(60%_50%_at_15%_0%,rgba(224,145,42,0.16),transparent_60%)]"
    ></div>

    <div class="shell relative">

        <header class="mb-12 md:mb-16">
            <p class="eyebrow mb-5" data-reveal>Experience</p>
            <div class="grid gap-6 md:grid-cols-[1.2fr_0.8fr] md:items-end">
                <h2 class="display-lg text-bone" data-reveal-clip>
                    Where the work <span class="text-marigold italic">actually shipped</span>.
                </h2>
                <p class="text-bone/60 md:pb-2" data-reveal data-reveal-delay="0.1">
                    Three engineering roles and a sales floor. Every one of them
                    put something real in front of real people.
                </p>
            </div>
        </header>

        <ol class="flex flex-col" role="list">
            {ROLES.map((role, i) => (
                <li
                    class:list={[
                        'group grid gap-6 border-t border-bone/15 md:grid-cols-[auto_1fr] md:gap-10',
                        role.compact ? 'py-7 md:py-8' : 'py-9 md:py-11',
                    ]}
                    data-reveal
                    data-reveal-delay={String(i * 0.05)}
                >
                    <!-- index + logo rail -->
                    <div class="flex items-start gap-4 md:w-40 md:flex-col md:gap-5">
                        <span class="font-mono text-xs tracking-[0.18em] text-bone/40">
                            0{i + 1}
                        </span>
                        {role.logo && (
                            <Picture
                                slug={role.logo.slug}
                                widths={role.logo.widths}
                                width={role.logo.w}
                                height={role.logo.h}
                                ext={role.logo.ext}
                                alt=""
                                sizes="96px"
                                class="h-9 w-auto rounded-md bg-bone/95 object-contain p-1"
                            />
                        )}
                    </div>

                    <div>
                        <div class="mb-4 flex flex-wrap items-baseline gap-x-4 gap-y-2">
                            <h3
                                class:list={[
                                    'font-display leading-none text-bone',
                                    role.compact ? 'text-2xl md:text-3xl' : 'text-3xl md:text-4xl',
                                ]}
                            >
                                {role.title}
                            </h3>
                            {role.current && (
                                <span class="chip border-marigold/40 bg-marigold/10 text-marigold">
                                    Current
                                </span>
                            )}
                        </div>

                        <p class="mb-5 font-mono text-[0.72rem] uppercase tracking-[0.14em] text-bone/50">
                            {role.org} · {role.location} · {role.period}
                        </p>

                        {role.metrics && (
                            <ul class="mb-6 flex flex-wrap gap-2.5" role="list">
                                {role.metrics.map((metric) => (
                                    <li class="rounded-lg border border-marigold/30 bg-marigold/[0.08] px-3.5 py-2 font-mono text-[0.72rem] tracking-[0.06em] text-marigold">
                                        {metric}
                                    </li>
                                ))}
                            </ul>
                        )}

                        <ul class="mb-6 flex max-w-[70ch] flex-col gap-3.5" role="list">
                            {role.points.map((point) => (
                                <li class="relative pl-6 text-[0.95rem] leading-relaxed text-bone/75">
                                    <span
                                        aria-hidden="true"
                                        class="absolute left-0 top-[0.68em] h-1.5 w-1.5 rounded-full bg-marigold"
                                    ></span>
                                    <Fragment set:html={highlight(point)} />
                                </li>
                            ))}
                        </ul>

                        {role.stack && (
                            <div class="flex flex-wrap gap-2">
                                {role.stack.map((tech) => (
                                    <span class="chip border-bone/20 bg-bone/5 text-bone/65">
                                        {tech}
                                    </span>
                                ))}
                            </div>
                        )}
                    </div>
                </li>
            ))}
        </ol>
    </div>
</section>
