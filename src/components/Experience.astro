---
import { ROLES } from '../data/site';
import Picture from './Picture.astro';
import { highlight } from '../lib/highlight';
---

<section id="experience" class="py-16 md:py-20">
    <div class="shell">

        <header class="mb-10 md:mb-12">
            <p class="hand-note mb-2" data-reveal>the receipts!</p>
            <div class="flex flex-wrap items-end gap-4" data-reveal>
                <h2 class="text-[clamp(1.9rem,4vw,2.9rem)] font-extrabold tracking-tight">
                    Where I've <span class="hl">worked</span>.
                </h2>
                <p class="max-w-[38ch] pb-1 text-sm text-ink-mute">
                    Two internships and a research lab, and exactly what I did
                    at each one.
                </p>
            </div>
        </header>

        <ol class="flex flex-col gap-8" role="list">
            {ROLES.map((role, i) => (
                <li class="relative" data-reveal data-reveal-delay={String(i * 0.05)}>
                    <!-- number sticker pinned to the card edge -->
                    <span
                        class:list={[
                            'sticker absolute -top-3 left-5 z-10',
                            ['st-yellow', 'st-pink', 'st-sky', 'st-mint'][i % 4],
                        ]}
                    >
                        0{i + 1}
                    </span>

                    <article class="card p-6 md:p-7">
                        <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-3">
                            {role.logo && (
                                <span class="grid h-11 w-11 flex-none place-items-center rounded-lg border-2 border-ink bg-white p-1 shadow-[2px_2px_0_var(--color-ink)]">
                                    <Picture
                                        slug={role.logo.slug}
                                        widths={role.logo.widths}
                                        width={role.logo.w}
                                        height={role.logo.h}
                                        ext={role.logo.ext}
                                        alt=""
                                        sizes="40px"
                                        class="h-full w-auto object-contain"
                                    />
                                </span>
                            )}
                            <div>
                                <h3 class:list={['font-extrabold leading-tight tracking-tight', role.compact ? 'text-lg' : 'text-xl md:text-2xl']}>
                                    {role.title}
                                </h3>
                                <p class="label-mono mt-1 text-ink-mute">
                                    {role.org} · {role.location} · {role.period}
                                </p>
                            </div>
                            {role.current && (
                                <span class="chip chip-live ml-auto"><i aria-hidden="true"></i>Current</span>
                            )}
                        </div>

                        <ul class="flex max-w-[75ch] flex-col gap-2.5" role="list">
                            {role.points.map((point) => (
                                <li class="relative pl-6 text-[0.94rem] leading-relaxed text-ink-soft">
                                    <span aria-hidden="true" class="absolute left-0 top-[0.5em] h-2 w-2 rounded-sm border border-ink" style="background: var(--color-st-blue)"></span>
                                    <Fragment set:html={highlight(point)} />
                                </li>
                            ))}
                        </ul>

                        {role.stack && (
                            <div class="mt-5 flex flex-wrap gap-2">
                                {role.stack.map((tech) => <span class="chip">{tech}</span>)}
                            </div>
                        )}
                    </article>
                </li>
            ))}
        </ol>
    </div>
</section>
