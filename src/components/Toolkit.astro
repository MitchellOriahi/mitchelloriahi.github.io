---
import { TOOLKIT, EDUCATION } from '../data/site';

const groupColors = ['st-yellow', 'st-mint', 'st-sky', 'st-pink'];
---

<section id="toolkit" class="py-16 md:py-20">
    <div class="shell">

        <header class="mb-10 md:mb-12">
            <p class="hand-note mb-2" data-reveal>the toolbox</p>
            <div class="flex flex-wrap items-end gap-4" data-reveal>
                <h2 class="text-[clamp(1.9rem,4vw,2.9rem)] font-extrabold tracking-tight">
                    What I <span class="hl">work with</span>.
                </h2>
                <p class="max-w-[40ch] pb-1 text-sm text-ink-mute">
                    The languages, hardware, and tools I reach for, and the
                    degree behind them.
                </p>
            </div>
        </header>

        <!-- skills: four cards with sticker headers -->
        <div class="mb-10 grid items-start gap-6 sm:grid-cols-2 xl:grid-cols-4">
            {TOOLKIT.map((group, i) => (
                <div class:list={['card relative p-5 pt-7', i % 2 ? 'tilt-r2' : 'tilt-l2']} data-reveal data-reveal-delay={String(i * 0.05)}>
                    <span class:list={['sticker absolute -top-3 left-4', groupColors[i % 4], i % 2 ? 'tilt-r' : 'tilt-l']}>
                        {group.name}
                    </span>
                    <ul class="flex flex-wrap gap-2 pt-2" role="list">
                        {group.items.map((item) => (
                            <li class="chip">{item}</li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>

        <!-- education: notebook card with Texas Tech stickers -->
        <aside class="card relative overflow-visible p-6 md:p-8" data-reveal data-reveal-delay="0.1">
            <span class="tape -top-3 left-10 -rotate-3" aria-hidden="true"></span>
            <span class="tape tape-pink -top-3 right-10 rotate-2" aria-hidden="true"></span>
            <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1.5 rounded-t-[12px]" style="background: var(--color-ttured)"></span>

            <div class="grid gap-8 lg:grid-cols-[1fr_auto_1.1fr] lg:gap-10">

                <!-- identity + degree facts -->
                <div>
                    <div class="mb-1 flex items-center gap-3">
                        <img
                            src="/img/logo-ttu-192.png"
                            srcset="/img/logo-ttu-96.png 96w, /img/logo-ttu-192.png 192w"
                            sizes="36px"
                            width="192" height="225"
                            alt="Texas Tech University Double T"
                            class="h-10 w-auto object-contain"
                            loading="lazy" decoding="async"
                        />
                        <h3 class="text-2xl font-extrabold tracking-tight md:text-3xl">{EDUCATION.school}</h3>
                    </div>
                    <p class="mb-6 text-sm text-ink-mute">
                        {EDUCATION.college} · {EDUCATION.location}
                    </p>

                    <dl class="flex flex-col gap-3 border-t-2 border-ink/10 pt-5">
                        <div class="flex items-baseline justify-between gap-4">
                            <dt class="text-sm text-ink-mute">Degree</dt>
                            <dd class="text-right text-sm font-bold">{EDUCATION.degree}</dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-4">
                            <dt class="text-sm text-ink-mute">Track</dt>
                            <dd class="text-right text-sm font-bold">{EDUCATION.track}</dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-4">
                            <dt class="text-sm text-ink-mute">GPA</dt>
                            <dd class="label-mono text-right !text-base font-bold">
                                <span data-count={EDUCATION.gpa} data-decimals="2">{EDUCATION.gpa}</span> / 4.00
                            </dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-4">
                            <dt class="text-sm text-ink-mute">Graduating</dt>
                            <dd class="text-right text-sm font-bold">{EDUCATION.graduation}</dd>
                        </div>
                    </dl>

                    <div class="mt-5 flex flex-wrap gap-2.5">
                        {EDUCATION.honors.map((honor, i) => (
                            <span class:list={['sticker', i % 2 ? 'tilt-r' : 'tilt-l']} style="background: #ffe3e3;">
                                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="#cc0000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="m12 3 2.6 5.6 6 .8-4.4 4.2 1.1 6L12 16.8 6.7 19.6l1.1-6L3.4 9.4l6-.8Z" />
                                </svg>
                                {honor}
                            </span>
                        ))}
                    </div>
                </div>

                <div aria-hidden="true" class="hidden w-0.5 bg-ink/10 lg:block"></div>

                <!-- coursework + certifications -->
                <div>
                    <p class="hand-note mb-3">classes that mattered</p>
                    <ul class="flex flex-wrap gap-2" role="list">
                        {EDUCATION.coursework.map((course) => (
                            <li class="chip">{course}</li>
                        ))}
                    </ul>

                    <p class="hand-note mt-6 mb-3">certified</p>
                    <ul class="flex flex-wrap gap-2" role="list">
                        {EDUCATION.certs.map((cert) => (
                            <li class="chip">
                                <img src="/img/tech/matlab.svg" alt="" width="14" height="14" class="h-3.5 w-3.5" aria-hidden="true" loading="lazy" />
                                {cert.name} · {cert.org} {cert.year}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </aside>
    </div>
</section>
