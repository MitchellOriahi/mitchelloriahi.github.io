---
/**
 * Picture.astro
 * Renders a <picture> with a WebP source and an original format fallback,
 * across every width that tools/build-images.ps1 emitted for the slug.
 *
 * Why not Astro's <Image />: the derivatives here are pre-generated by an
 * ImageMagick script from originals that deliberately stay out of the deployed
 * bundle. This component just points at that output.
 */

interface Props {
    /** Basename in /public/img, without the width suffix or extension. */
    slug: string;
    alt: string;
    /** Widths that exist on disk for this slug. */
    widths: readonly number[];
    /** Intrinsic size of the LARGEST derivative, for layout reservation. */
    width: number;
    height: number;
    /** Fallback format. WebP is always emitted alongside it. */
    ext?: 'jpg' | 'png';
    sizes?: string;
    class?: string;
    /** Skip lazy loading. Use only for above the fold imagery. */
    eager?: boolean;
}

const {
    slug,
    alt,
    widths,
    width,
    height,
    ext = 'jpg',
    sizes = '100vw',
    class: className = '',
    eager = false,
} = Astro.props;

const srcset = (format: string) =>
    widths.map((w) => `/img/${slug}-${w}.${format} ${w}w`).join(', ');

const largest = widths[widths.length - 1];
---

<picture>
    <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
    <img
        src={`/img/${slug}-${largest}.${ext}`}
        srcset={srcset(ext)}
        sizes={sizes}
        width={width}
        height={height}
        alt={alt}
        class={className}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
    />
</picture>
