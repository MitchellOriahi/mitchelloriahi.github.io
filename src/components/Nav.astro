---
import { NAV, SITE } from '../data/site';
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 px-[var(--gutter)] py-4 md:py-6">
    <nav
        id="site-nav"
        aria-label="Primary"
        data-stuck="false"
        class="pointer-events-auto mx-auto flex max-w-[68rem] items-center gap-2 rounded-full border border-transparent px-2 py-2 transition-[background-color,border-color,box-shadow,backdrop-filter] duration-500 data-[stuck=true]:border-rule-soft data-[stuck=true]:bg-paper/80 data-[stuck=true]:shadow-[0_10px_40px_-24px_rgba(23,20,16,0.5)] data-[stuck=true]:backdrop-blur-xl"
    >
        <a
            href="#top"
            class="group flex items-center gap-2.5 rounded-full px-4 py-2 text-[0.95rem] font-bold tracking-tight"
        >
            <span class="grid h-7 w-7 place-items-center rounded-full bg-ink text-[0.7rem] font-bold text-bone transition-colors duration-500 group-hover:bg-accent group-hover:text-ink">
                MO
            </span>
            <span class="hidden sm:inline">{SITE.shortName} Oriahi</span>
        </a>

        <ul class="ml-auto hidden items-center gap-1 md:flex">
            {NAV.map((item) => (
                <li>
                    <a
                        href={`#${item.id}`}
                        data-nav-link
                        data-active="false"
                        class="nav-link rounded-full px-4 py-2 text-sm font-medium"
                    >
                        {item.label}
                    </a>
                </li>
            ))}
        </ul>

        <a
            href="#contact"
            data-magnetic="0.2"
            class="btn btn-accent ml-auto hidden md:ml-2 md:inline-flex"
        >
            Let's talk
            <span class="btn-badge" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12 12 4M6 4h6v6" />
                </svg>
            </span>
        </a>

        <button
            id="menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="menu-panel"
            aria-label="Open menu"
            class="ml-auto grid h-11 w-11 place-items-center rounded-full border border-rule bg-paper md:hidden"
        >
            <span class="sr-only">Menu</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M3 7h18M3 12h18M3 17h18" />
            </svg>
        </button>
    </nav>
</header>

<!--
    Mobile panel. Kept in the DOM and toggled with a data attribute so the
    transition can run and so focus has somewhere to land.
-->
<div
    id="menu-panel"
    data-open="false"
    class="invisible fixed inset-0 z-40 flex flex-col justify-center gap-2 bg-bone px-[var(--gutter)] opacity-0 transition-[opacity,visibility] duration-400 data-[open=true]:visible data-[open=true]:opacity-100 md:hidden"
>
    {NAV.map((item, i) => (
        <a
            href={`#${item.id}`}
            class="flex items-baseline gap-5 border-b border-rule-soft py-5 transition-colors hover:text-accent-deep"
        >
            <span class="font-mono text-xs text-ink-faint">0{i + 1}</span>
            <span class="display-md">{item.label}</span>
        </a>
    ))}

    <a href="#contact" class="btn btn-solid mt-8 justify-center">
        Get in touch
    </a>

    <a href={SITE.resume} target="_blank" rel="noopener" class="btn btn-ghost mt-3 justify-center">
        Download resume
    </a>
</div>
