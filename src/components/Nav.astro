---
import { NAV, SITE } from '../data/site';

/** Tiny glyphs for the nav tabs, in reference-sticker spirit. */
const glyphs: Record<string, string> = {
    experience: '<path d="M4 7h16v13H4zM8 7V4h8v3"/>',
    work: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>',
    toolkit: '<path d="m14.7 6.3 3 3L7 20H4v-3zM13 5l3-3 3 3-3 3z"/>',
    about: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>',
};
---

<header class="sticky top-0 z-50 border-b-2 border-ink bg-paper/95 backdrop-blur-sm">
    <nav
        id="site-nav"
        aria-label="Primary"
        data-stuck="false"
        class="shell flex items-center gap-2 py-2.5"
    >
        <a href="#top" class="group flex items-center gap-2" aria-label="Back to top">
            <span class="grid h-8 w-8 place-items-center rounded-full border-2 border-ink bg-st-hotpink text-[0.6rem] font-bold text-white shadow-[2px_2px_0_var(--color-ink)] transition-transform duration-200 group-hover:rotate-[-8deg]" style="background: var(--color-st-hotpink)">
                MO
            </span>
        </a>

        <ul class="ml-2 hidden items-center gap-1 md:flex">
            {NAV.map((item) => (
                <li>
                    <a href={`#${item.id}`} data-nav-link data-active="false" class="nav-link">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={glyphs[item.id] ?? ''} />
                        {item.label}
                    </a>
                </li>
            ))}
        </ul>

        <div class="ml-auto flex items-center gap-2">
            <a
                href={SITE.linkedin}
                target="_blank" rel="noopener"
                aria-label="LinkedIn"
                class="grid h-8 w-8 place-items-center rounded-full border-2 border-ink text-ink shadow-[2px_2px_0_var(--color-ink)] transition-transform duration-200 hover:-translate-y-0.5"
                style="background: var(--color-st-sky)"
            >
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.5v.01M12 17v-3.6a2.4 2.4 0 0 1 4.8 0V17"/></svg>
            </a>
            <a
                href={SITE.github}
                target="_blank" rel="noopener"
                aria-label="GitHub"
                class="grid h-8 w-8 place-items-center rounded-full border-2 border-ink text-ink shadow-[2px_2px_0_var(--color-ink)] transition-transform duration-200 hover:-translate-y-0.5"
                style="background: var(--color-st-mint)"
            >
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>
            </a>

            <a href="#contact" class="btn hidden !py-2 md:inline-flex" style="background: var(--color-st-yellow)">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 8.6a5.5 5.5 0 0 0-8.3-.7l-.5.5-.5-.5a5.5 5.5 0 0 0-8.3 7.1 5.5 5.5 0 0 0 .6.7L12 24l8.2-8.3a5.5 5.5 0 0 0 .6-7.1z" transform="scale(0.86) translate(2 -1)"/></svg>
                Contact
            </a>

            <button
                id="menu-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="menu-panel"
                aria-label="Open menu"
                class="grid h-9 w-9 place-items-center rounded-lg border-2 border-ink bg-card shadow-[2px_2px_0_var(--color-ink)] md:hidden"
            >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
            </button>
        </div>
    </nav>
</header>

<!-- Mobile panel -->
<div
    id="menu-panel"
    data-open="false"
    class="invisible fixed inset-0 z-40 flex flex-col justify-center gap-3 bg-paper px-8 opacity-0 transition-[opacity,visibility] duration-300 data-[open=true]:visible data-[open=true]:opacity-100 md:hidden"
>
    {NAV.map((item, i) => (
        <a
            href={`#${item.id}`}
            class="flex items-baseline gap-4 border-b-2 border-ink/15 py-4 text-3xl font-extrabold tracking-tight"
        >
            <span class="label-mono text-ink-mute">0{i + 1}</span>
            {item.label}
        </a>
    ))}
    <a href="#contact" class="btn btn-solid mt-6 justify-center">Contact</a>
    <a href={SITE.resume} target="_blank" rel="noopener" class="btn mt-2 justify-center">Resume</a>
</div>
