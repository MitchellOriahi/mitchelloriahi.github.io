---
import { PROOF, TICKER } from '../data/site';
---

<section aria-label="Experience and education at a glance" class="pb-4">

    <div class="shell py-10 md:py-12">
        <div class="mb-8 flex items-center gap-4">
            <span class="sec-tab">experience across</span>
            <svg class="hidden w-14 text-ink md:block" viewBox="0 0 60 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 6 C 20 4, 40 10, 56 18" /><path d="M47 19 l 9 -1 -3 -8" />
            </svg>
        </div>

        <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4" role="list">
            {PROOF.map((item, i) => (
                <li
                    class="card flex flex-col justify-between gap-5 p-5"
                    data-reveal
                    data-reveal-delay={String(i * 0.06)}
                >
                    <div class="flex h-12 items-center">
                        {item.logo === 'cba' && (
                            <img src="/img/logo-cba-192.jpg" srcset="/img/logo-cba-96.jpg 96w, /img/logo-cba-192.jpg 192w" sizes="110px" width="192" height="108" alt="Christian Brothers Automotive" class="h-10 w-auto object-contain object-left" loading="lazy" decoding="async" />
                        )}
                        {item.logo === 'ttu' && (
                            <img src="/img/logo-ttu-192.png" srcset="/img/logo-ttu-96.png 96w, /img/logo-ttu-192.png 192w" sizes="40px" width="192" height="225" alt="Texas Tech University" class="h-10 w-auto object-contain object-left" loading="lazy" decoding="async" />
                        )}
                        {item.logo === 'coe' && (
                            <img src="/img/logo-coe-180.png" srcset="/img/logo-coe-96.png 96w, /img/logo-coe-180.png 180w" sizes="48px" width="180" height="180" alt="Edward E. Whitacre Jr. College of Engineering" class="h-12 w-auto object-contain object-left" loading="lazy" decoding="async" />
                        )}
                    </div>

                    <div>
                        <h3 class="text-lg font-extrabold leading-tight">{item.role}</h3>
                        <p class="mt-1 text-sm font-semibold text-ink-soft">{item.org}</p>
                        <p class="mt-0.5 text-sm text-ink-mute">{item.note}</p>
                        <span class="sticker st-butter mt-3">{item.period}</span>
                    </div>
                </li>
            ))}
        </ul>
    </div>

    <!-- technology ticker on a butter band -->
    <div class="border-y-2 border-ink py-4" style="background: var(--color-st-butter)">
        <div class="marquee" style="--marquee-gap:3rem; --marquee-duration:46s;">
            {[0, 1].map((copy) => (
                <ul class="marquee__track" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
                    {TICKER.map((tech) => (
                        <li class="flex flex-none items-center gap-12">
                            <span class="flex items-center gap-2.5">
                                {tech.icon && (
                                    <img src={`/img/tech/${tech.icon}.svg`} alt="" width="18" height="18" class="h-[18px] w-[18px] object-contain" loading="lazy" decoding="async" aria-hidden="true" />
                                )}
                                <span class="label-mono text-ink">{tech.label}</span>
                            </span>
                            <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full border border-ink" style="background: var(--color-st-hotpink)"></span>
                        </li>
                    ))}
                </ul>
            ))}
        </div>
    </div>
</section>
