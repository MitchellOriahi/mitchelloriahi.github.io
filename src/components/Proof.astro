---
import { PROOF, TICKER } from '../data/site';

/*
    Four proof squares: both internships, the research post, and the degree,
    each with its own mark.
*/
---

<section class="border-y border-rule-soft bg-paper/60" aria-label="Experience and education at a glance">

    <div class="shell py-12 md:py-16">
        <p class="eyebrow mb-9" data-reveal>Experience across</p>

        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4" role="list">
            {PROOF.map((item, i) => (
                <li
                    class="card group flex flex-col justify-between gap-6 p-5 transition-[border-color,transform] duration-500 hover:-translate-y-1 hover:border-rule md:p-6"
                    data-reveal
                    data-reveal-delay={String(i * 0.06)}
                >
                    <div class="flex h-14 items-center">
                        {item.logo === 'cba' && (
                            <img
                                src="/img/logo-cba-192.jpg"
                                srcset="/img/logo-cba-96.jpg 96w, /img/logo-cba-192.jpg 192w"
                                sizes="120px"
                                width="192" height="108"
                                alt="Christian Brothers Automotive"
                                class="h-10 w-auto object-contain object-left"
                                loading="lazy" decoding="async"
                            />
                        )}
                        {item.logo === 'ttu' && (
                            <img
                                src="/img/logo-ttu-192.png"
                                srcset="/img/logo-ttu-96.png 96w, /img/logo-ttu-192.png 192w"
                                sizes="40px"
                                width="192" height="225"
                                alt="Texas Tech University"
                                class="h-10 w-auto object-contain object-left"
                                loading="lazy" decoding="async"
                            />
                        )}
                        {item.logo === 'coe' && (
                            <img
                                src="/img/logo-coe-180.png"
                                srcset="/img/logo-coe-96.png 96w, /img/logo-coe-180.png 180w"
                                sizes="44px"
                                width="180" height="180"
                                alt="Edward E. Whitacre Jr. College of Engineering"
                                class="h-14 w-auto object-contain object-left"
                                loading="lazy" decoding="async"
                            />
                        )}
                    </div>

                    <div>
                        <h3 class="font-display text-2xl leading-tight">{item.role}</h3>
                        <p class="mt-1.5 text-sm font-medium text-ink-soft">{item.org}</p>
                        <p class="mt-1 text-sm text-ink-mute">{item.note}</p>
                        <p class="mt-3 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-ink-faint">
                            {item.period}
                        </p>
                    </div>
                </li>
            ))}
        </ul>
    </div>

    <!-- ---------- technology ticker ---------- -->
    <!--
        The track renders twice; the keyframe travels one full track width plus
        one gap, so the duplicate lands exactly where the original began. The
        copy is aria-hidden so screen readers hear the list once.
    -->
    <div class="border-t border-rule-soft py-5">
        <div class="marquee" style="--marquee-gap:3rem; --marquee-duration:46s;">
            {[0, 1].map((copy) => (
                <ul class="marquee__track" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
                    {TICKER.map((tech) => (
                        <li class="flex flex-none items-center gap-12">
                            <span class="font-mono text-[0.78rem] uppercase tracking-[0.14em] text-ink-mute">
                                {tech}
                            </span>
                            <span aria-hidden="true" class="h-1 w-1 rounded-full bg-marigold"></span>
                        </li>
                    ))}
                </ul>
            ))}
        </div>
    </div>
</section>
